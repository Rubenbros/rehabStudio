# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://rehabstudio.example.com

# --- Base de datos (Cloud SQL, PostgreSQL) ---
# Local: a través del Cloud SQL Auth Proxy.
DATABASE_URL=postgresql://rehab_app:PASSWORD@127.0.0.1:5433/rehab
# Cloud Run: socket Unix del conector de Cloud SQL.
# DATABASE_URL=postgresql://rehab_app:PASSWORD@localhost/rehab?host=/cloudsql/PROJECT:REGION:INSTANCE
#
# Solo para `npm test`: si está definida, se ejecuta el test de integración
# contra esa base (crea y borra su propio esquema, no toca los datos reales).
# DATABASE_URL_TEST=postgresql://rehab_app:PASSWORD@127.0.0.1:5433/rehab

# --- Twilio (WhatsApp) ---
# Sandbox example: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Vertex AI (Gemini) ---
# Sin API key: autenticacion por ADC (`gcloud auth application-default login`).
# Las tres son opcionales y tienen valor por defecto; se listan para documentarlas.
GOOGLE_CLOUD_PROJECT=rehab-studio-web
VERTEX_LOCATION=europe-west1
GEMINI_MODEL=google/gemini-2.5-flash

# --- Google Calendar (OAuth) ---
# Create OAuth client (Web) in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/google/oauth/callback
# Obtained after running /api/google/oauth/start once with the owner account
GOOGLE_REFRESH_TOKEN=
# Calendar to use (primary by default)
GOOGLE_CALENDAR_ID=primary

# --- Business config ---
# E.164 format, no whatsapp: prefix. Used to identify the owner in inbound webhooks.
OWNER_PHONE=+34600000000
OWNER_EMAIL=owner@example.com
CLINIC_NAME=rehabStudio
CLINIC_TIMEZONE=Europe/Madrid
CLINIC_ADDRESS=Calle Ejemplo 1, Madrid
SESSION_PRICE_EUR=60
FOLLOWUP_PRICE_EUR=30

# --- Secrets ---
# Used to authenticate the reminders cron and the MCP server. Generate random strings.
CRON_SECRET=replace-with-long-random-string
MCP_BEARER_TOKEN=replace-with-long-random-string
