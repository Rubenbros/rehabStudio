# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://rehabstudio.example.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- WhatsApp Cloud API (Meta) ---
# Meta App → WhatsApp → API Setup. Phone number ID of the sending number (NOT the
# phone number itself) and a permanent access token (system user token).
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any random string you choose; must match the "Verify token" entered in
# Meta App → WhatsApp → Configuration → Webhook.
WHATSAPP_VERIFY_TOKEN=replace-with-long-random-string
# Meta App → Settings → Basic → App secret. Validates the X-Hub-Signature-256 header.
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Graph API version (defaults to v21.0)
WHATSAPP_API_VERSION=v21.0
# Optional: set to "false" to skip signature validation in local dev only.
# WHATSAPP_VALIDATE_SIGNATURE=false

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Google Calendar (OAuth) ---
# Create OAuth client (Web) in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/google/oauth/callback
# Obtained after running /api/google/oauth/start once with the owner account
GOOGLE_REFRESH_TOKEN=
# Calendar to use (primary by default)
GOOGLE_CALENDAR_ID=primary

# --- Business config ---
# E.164 format, no whatsapp: prefix. Used to identify the owner in inbound webhooks.
OWNER_PHONE=+34600000000
OWNER_EMAIL=owner@example.com
CLINIC_NAME=rehabStudio
CLINIC_TIMEZONE=Europe/Madrid
CLINIC_ADDRESS=Calle Ejemplo 1, Madrid
SESSION_PRICE_EUR=60
FOLLOWUP_PRICE_EUR=30

# --- Secrets ---
# Used to authenticate Vercel cron calls and MCP server. Generate random strings.
CRON_SECRET=replace-with-long-random-string
MCP_BEARER_TOKEN=replace-with-long-random-string
